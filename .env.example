# Copier ce fichier en `.env` et remplir les valeurs réelles.
# Ces mêmes variables doivent être renseignées dans Vercel (Project → Settings → Environment Variables).

# --- Base de données (Supabase Postgres) ---
# Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Sessions ---
# Chaîne aléatoire longue et secrète (ex: générée avec `openssl rand -base64 32`).
SESSION_SECRET=""

# URL publique de l'app (utilisée dans les liens des e-mails).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase Storage ---
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cadence-uploads"

# --- Resend (e-mails transactionnels) ---
# Laisser vide en dev pour simuler les e-mails localement.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Cadence <onboarding@resend.dev>"
